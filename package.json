{
  "name": "supplychain-sentry",
  "version": "0.1.0",
  "description": "Scan npm dependencies for supply chain security risks - detect malicious packages before they compromise your project",
  "main": "dist/cli.js",
  "module": "dist/cli.mjs",
  "types": "dist/cli.d.ts",
  "bin": {
    "sentry-scan": "./dist/cli.js",
    "scs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".sentryrc.example"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "npm run build && npm test",
    "release": "npm run build && npm publish"
  },
  "keywords": [
    "security",
    "supply-chain",
    "npm",
    "package",
    "scanner",
    "malware",
    "dependency-audit",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lichen-zhang/supplychain-sentry.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "cli-table3": "^0.6.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
